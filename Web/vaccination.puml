opPr --> addAnimal
docPr --> addAnimal
docVet --> addAnimal

opPr --> deleteAnimal
docPr --> deleteAnimal
docVet --> deleteAnimal

opPr --> updateAnimal
docPr --> updateAnimal
docVet --> updateAnimal

opPr --> loadImg
docPr --> loadImg
docVet --> loadImg

opPr --> deleteImg
